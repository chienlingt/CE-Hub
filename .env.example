# Root .env example
# Copy this file to create your .env files for deployment

# ===========================================
# SERVER ENVIRONMENT VARIABLES (server/.env)
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/tbm_delivery"
PORT=4000
CLIENT_URL="http://localhost:3000"
JWT_SECRET="your-secret-key-change-in-production-use-crypto-randomBytes"
NODE_ENV="development"

# ===========================================
# CLIENT ENVIRONMENT VARIABLES (client/.env)
# ===========================================
REACT_APP_API_BASE_URL="http://localhost:4000"

# ===========================================
# DEPLOYMENT NOTES
# ===========================================
#
# For Render/Railway/Vercel:
# - Set these as environment variables in the platform dashboard
# - DATABASE_URL will be auto-provided by Render/Railway for PostgreSQL
# - Change CLIENT_URL to your deployed frontend URL
# - Change REACT_APP_API_BASE_URL to your deployed backend URL
# - Generate JWT_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# For production:
# - Never commit actual .env files
# - Use strong JWT_SECRET (32+ random characters)
# - Use HTTPS URLs for CLIENT_URL and REACT_APP_API_BASE_URL
# - Set NODE_ENV=production
