# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to GitHub

# ── Database ──────────────────────────────────────────────────────────────────
# PRODUCTION (TBM live DB — use only for deployment)
# DATABASE_URL=postgres://postgres:tbm2u@lab.tbm2u.net:5432/logistics?schema=public

# SANDBOX (safe for development and testing)
DATABASE_URL=postgres://postgres:tbm2u@lab.tbm2u.net:5432/logistics_sandbox?schema=public

# LOCAL (if running PostgreSQL locally)
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/logistics?schema=public

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:3000
JWT_SECRET=change-this-to-a-strong-random-secret

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Generate App Password at: myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="xxxx xxxx xxxx xxxx"
EMAIL_FROM="TBM Delivery <noreply@gmail.com>"

# ── WhatsApp — Green API (free, 1500 msg/month) ───────────────────────────────
# Sign up at green-api.com → create instance → scan QR with WhatsApp app
GREEN_API_INSTANCE=YOUR_INSTANCE_ID
GREEN_API_TOKEN=YOUR_INSTANCE_TOKEN

# ── Odoo ERP Integration ──────────────────────────────────────────────────────
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin
ODOO_WEBHOOK_SECRET=change-this-to-a-strong-random-secret
