generator client {
  provider = "prisma-client-js"
}

model route_geocode_cache {
  address_key   String    @id @db.VarChar(64)
  address       String
  latitude      Float?
  longitude     Float?
  expires_at    DateTime?
  next_retry_at DateTime  @default(now())
  attempts      Int       @default(0)
  last_error    String?
  updated_at    DateTime  @default(now()) @updatedAt

  @@index([next_retry_at])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  permissions String[]    @default([])
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  employees   employees[]
}

model employees {
  id                                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                  String?
  display_name                          String?
  email                                 String?                     @unique
  contact_number                        String?
  role_id                               String?                     @db.Uuid
  active_flag                           Boolean                     @default(true)
  password                              String?
  bio                                   String?
  created_at                            DateTime                    @default(now())
  updated_at                            DateTime                    @updatedAt
  outlet_id                             String?                     @db.Uuid
  expo_push_token                       String?
  teamAssignments                       employee_team_assignments[]
  role                                  roles?                      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outlets                               outlets?                    @relation(fields: [outlet_id], references: [id], onUpdate: NoAction, map: "fk_employees_outlet")
  installers                            installers?
  orders                                orders[]
  reports                               reports[]                   @relation("EmployeeReports")
  trucks_trucks_assistant_idToemployees trucks[]                    @relation("trucks_assistant_idToemployees")
  trucks_trucks_driver_idToemployees    trucks[]                    @relation("trucks_driver_idToemployees")
  lorry_trips_assistant_idToemployees   lorry_trips[]               @relation("lorry_trips_assistant_idToemployees")
  lorry_trips_driver_idToemployees      lorry_trips[]               @relation("lorry_trips_driver_idToemployees")
  teams_primary_driverToemployees       teams[]                     @relation("teams_primary_driverToemployees")
  teams_assistant_driverToemployees     teams[]                     @relation("teams_assistant_driverToemployees")
  order_point_awards                    order_point_awards[]
}

model teams {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_type              String?
  created_at             DateTime                    @default(now())
  available_flag         Boolean                     @default(true)
  primary_driver_id      String?                     @db.Uuid
  assistant_driver_id    String?                     @db.Uuid
  truck_id               String?                     @db.Uuid
  assignments            employee_team_assignments[]
  installation_schedules installation_schedules[]
  delivery_timeslots     time_slots[]                @relation("DeliveryTeamSlots")
  primary_driver         employees?                  @relation("teams_primary_driverToemployees", fields: [primary_driver_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_team_primary_driver")
  assistant_driver       employees?                  @relation("teams_assistant_driverToemployees", fields: [assistant_driver_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_team_assistant_driver")
  truck                  trucks?                     @relation("teams_truckTotrucks", fields: [truck_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_team_truck")
}

model employee_team_assignments {
  id          Int       @id @default(autoincrement())
  employee_id String    @db.Uuid
  team_id     String?   @db.Uuid
  assigned_at DateTime?
  employee    employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team        teams?    @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employee_id, team_id])
}

model zones {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_name   String?
  created_at  DateTime      @default(now())
  buildings   buildings[]
  truck_zones truck_zones[]
}

model buildings {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  building_name             String?
  housing_type              String?
  special_equipment_needed  String?
  vehicle_size_limit        String?
  vehicle_length_limit      String?
  vehicle_width_limit       String?
  postal_code               String?
  loading_bay_available     Boolean?
  access_time_window_start  String?
  access_time_window_end    String?
  pre_registration_required Boolean?
  zone_id                   String?   @db.Uuid
  lift_available            Boolean?
  lift_dimensions           String?
  notes                     String?
  parking_distance          String?
  narrow_doorways           Boolean?
  updated_at                DateTime?
  created_at                DateTime  @default(now())
  address                   String?
  latitude                  Decimal?  @db.Decimal(10, 8)
  longitude                 Decimal?  @db.Decimal(11, 8)
  zone                      zones?    @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                    orders[]
}

model access_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  changed_at DateTime?
  changes    Json?
}

model chats {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number    String?
  members         Json?
  names           Json?
  created_at      DateTime?
  last_message_at DateTime?
}

model customers {
  id                            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                     String?
  email                         String?
  phone                         String?
  address                       String?
  city                          String?
  postcode                      String?
  state                         String?
  created_at                    DateTime?
  notifications_enabled         Boolean?
  passwordhash                  String?
  preferred_delivery_time_start String?     @db.VarChar(10)
  preferred_delivery_time_end   String?     @db.VarChar(10)
  preferred_delivery_notes      String?
  expo_push_token               String?
  complaint                     complaint[]
  orders                        orders[]
  rating                        rating[]
}

model lorry_trips {
  id                                            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delivery_team_id                              String?
  truck_id                                      String?     @db.Uuid
  created_at                                    DateTime    @default(now())
  updated_at                                    DateTime?
  ended_at                                      DateTime?   @db.Timestamp(6)
  ended_by                                      String?     @db.Uuid
  started_at                                    DateTime?   @db.Timestamp(6)
  started_by                                    String?     @db.Uuid
  status                                        String?     @default("planned") @db.VarChar(20)
  time_slot_id                                  String?     @unique @db.Uuid
  // Trip-level driver/assistant — overrides the truck's default driver_id/assistant_id
  // for this specific run once the trip exists (from departure onward). Seeded from the
  // truck's defaults at departure; see deliveryLifecycleService.departTimeSlot().
  driver_id                                     String?     @db.Uuid
  assistant_id                                  String?     @db.Uuid
  time_slot                                     time_slots? @relation(fields: [time_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lorry_trip_time_slot")
  trucks                                        trucks?     @relation(fields: [truck_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_lorry_trips_driver_idToemployees    employees?  @relation("lorry_trips_driver_idToemployees", fields: [driver_id], references: [id], onUpdate: NoAction, map: "fk_lorry_trip_driver")
  employees_lorry_trips_assistant_idToemployees employees?  @relation("lorry_trips_assistant_idToemployees", fields: [assistant_id], references: [id], onUpdate: NoAction, map: "fk_lorry_trip_assistant")
}

model order_products {
  id                           Int       @id @default(autoincrement())
  order_id                     String    @db.Uuid
  product_id                   String?   @db.Uuid
  quantity                     Int?
  // Actual delivered count for this line, as opposed to `quantity` (ordered). Distinct
  // from `item_delivery_status` (delivered/failed) so true partial-unit delivery (e.g.
  // "3 of 5") is representable — defaults to quantity/0 by status until a caller
  // supplies an explicit value. See deliveryFailureService.confirmFailure() and
  // routes/order-products.js PATCH.
  delivered_quantity           Int?
  dismantle_required           Boolean?
  dismantle_time_min           Int?
  dismantle_time_max           Int?
  service_type                 String?   @db.VarChar(50)
  custom_installation_time_min Int?
  custom_installation_time_max Int?
  item_delivery_status         String?   @default("pending") @db.VarChar(20)
  loaded_at                    DateTime?
  loaded_by                    String?   @db.Uuid
  handling_status              String?   @default("pending") @db.VarChar(20)
  loaded_serial                String?
  assigned_serial              String?
  assigned_serials             String[]  @default([])
  prepared_quantity            Int?
  serial_tracking              String?
  // Per-unit scan records; legacy scalar fields remain the line-level summary.
  unit_scans                   Json?
  unloaded_at                  DateTime?
  unloaded_by                  String?   @db.Uuid
  unloaded_serial              String?
  odoo_line_id                 Int?
  // stock.move for new DO lines; null marks legacy/unknown IDs for reconciliation.
  odoo_line_model              String?   @db.VarChar(30)
  odoo_product_name            String?   @db.VarChar(255)
  orders                       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                     products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String?                   @db.Uuid
  building_id                String?                   @db.Uuid
  employee_id                String?                   @db.Uuid
  order_status               String?
  number_of_attempts         Int?
  customer_rating            Float?
  proof_of_delivery_url      String?
  customer_feedback          String?
  time_slot_id               String?                   @db.Uuid
  scheduled_start_date_time  DateTime?
  scheduled_end_date_time    DateTime?
  actual_start_date_time     DateTime?
  actual_end_date_time       DateTime?
  actual_arrival_date_time   DateTime?
  delivered_latitude         Float?
  delivered_longitude        Float?
  // Customer-requested delivery window as received from Odoo (picking.scheduled_date) at
  // order ingest — flows Odoo -> CE Hub, a preference only, not guaranteed. Previously
  // read by odooService.getOrderDetail() but silently dropped by pushOrder(); now
  // persisted. See odooOrderIngestService.js.
  preferred_timeslot         DateTime?
  created_at                 DateTime?
  updated_at                 DateTime?
  truck_loading_sequence     Int?
  notified_pending           Boolean?                  @default(false)
  notified_scheduled         Boolean?                  @default(false)
  special_equipment_needed   String?
  delivery_notes             String?
  delivery_evidence          String[]
  issue_priority_level       String?                   @db.VarChar(50)
  issue_reason               String?                   @db.VarChar(255)
  issue_desc                 String?
  issue_evidence             String[]
  delivery_start_date_time   DateTime?                 @db.Timestamp(6)
  delivery_end_date_time     DateTime?                 @db.Timestamp(6)
  install_start_date_time    DateTime?                 @db.Timestamp(6)
  install_end_date_time      DateTime?                 @db.Timestamp(6)
  delivery_address           String?
  delivery_city              String?
  delivery_postcode          String?
  delivery_state             String?
  issue_status               String?
  is_complaint_submitted     Boolean?                  @default(false)
  odoo_order_ref             String?                   @unique @db.VarChar(100)
  odoo_picking_id            Int?                      @unique
  doo_ready                  Boolean?
  assignment_status          String?                   @default("unassigned") @db.VarChar(30)
  delivery_remarks           String?
  original_delivery_address  String?
  remarks_contact_name       String?
  remarks_contact_phone      String?
  remarks_delivery_address   String?
  remarks_driver_notes       String?
  dispatched_by              String?                   @db.Uuid
  delivered_by               String?                   @db.Uuid
  notified_d1_at             DateTime?                 @db.Timestamp(6)
  notified_on_the_way_at     DateTime?                 @db.Timestamp(6)
  overdue_reminder_sent_at   DateTime?                 @db.Timestamp(6)
  salesperson_name           String?                   @db.VarChar(255)
  salesperson_phone          String?                   @db.VarChar(50)
  is_escalation_acknowledged Boolean?                  @default(false)
  rescheduled_from_order_id  String?                   @db.Uuid
  resolved_at                DateTime?                 @db.Timestamp(6)
  resolved_by                String?                   @db.Uuid
  issue_reported_at          DateTime?                 @db.Timestamp(6)
  odoo_sales_ref             String?                   @db.VarChar(100)
  // FRD INT-03/04/11 appointment confirmation, requested from the Odoo DOO.
  // See odooAppointmentService.js.
  appointment_request_ref       String?                @db.VarChar(100)
  requested_appointment_date    String?                @db.VarChar(10)
  requested_appointment_session String?                @db.VarChar(20)
  appointment_requirements      Json?
  delivery_document_requirement String?                @db.VarChar(30)
  appointment_status            String?                @db.VarChar(20)
  appointment_message           String?
  appointment_confirmed_at      DateTime?              @db.Timestamp(6)
  complaint                  complaint[]
  delivery_failure_events    delivery_failure_events[]
  installation_schedules     installation_schedules?
  order_products             order_products[]
  buildings                  buildings?                @relation(fields: [building_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                  customers?                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                  employees?                @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rescheduled_from           orders?                   @relation("OrderReschedule", fields: [rescheduled_from_order_id], references: [id], onUpdate: NoAction)
  rescheduled_to             orders[]                  @relation("OrderReschedule")
  time_slots                 time_slots?               @relation(fields: [time_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating                     rating[]
  order_point_awards         order_point_awards[]
  order_point_adjustments    order_point_adjustments[]
}

model products {
  id                              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_name                    String?
  package_length_cm               Int?
  package_height_cm               Int?
  package_width_cm                Int?
  fragile_flag                    Boolean?
  installer_team_required_flag    Boolean?
  dismantle_time                  Int?
  created_at                      DateTime         @default(now())
  estimated_installation_time_min Int?
  estimated_installation_time_max Int?
  no_lie_down_flag                Boolean?
  dismantle_required_flag         Boolean?
  available_flag                  Boolean          @default(true)
  // Optional override of incentive_rules.points_per_item for this product.
  points_per_item                 Float?
  order_products                  order_products[]
}

model reports {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content     String?
  status      String?
  created_at  DateTime?
  employee_id String?    @db.Uuid
  employee    employees? @relation("EmployeeReports", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// Also has a partial unique index that Prisma cannot express, created by hand in
// migration 20261103000000_time_slots_unassigned_unique:
//   (date, time_window_start) WHERE truck_id IS NULL
model time_slots {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                    String?
  time_window_start       String?
  time_window_end         String?
  available_flag          Boolean?
  created_at              DateTime?
  delivery_team_id        String?      @db.Uuid
  truck_id                String?      @db.Uuid
  loading_start_date_time DateTime?    @db.Timestamp(6)
  loading_end_date_time   DateTime?    @db.Timestamp(6)
  departed_at             DateTime?    @db.Timestamp(6)
  ended_at                DateTime?    @db.Timestamp(6)
  ended_by                String?      @db.Uuid
  slot_status             String?      @default("scheduled") @db.VarChar(30)
  started_by              String?      @db.Uuid
  // Route Optimisation (B.2) output — computed once per scheduler run, consumed
  // by the driver Route tab so it never has to re-call Google Maps itself.
  route_polyline          String?
  route_distance_m        Int?
  route_duration_s        Int?
  route_computed_at       DateTime?    @db.Timestamp(6)
  // Full B.2 plan: ordered stops, per-leg metrics, ETAs, scoring and fallback metadata.
  route_plan              Json?
  route_version           Int          @default(0)
  route_last_reason       String?      @db.VarChar(100)
  orders                  orders[]
  lorry_trip              lorry_trips?
  delivery_team           teams?       @relation("DeliveryTeamSlots", fields: [delivery_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_slots_delivery_team")
  truck                   trucks?      @relation(fields: [truck_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_slots_truck")
}

model truck_zones {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id         String?  @db.Uuid
  is_primary_zone Boolean?
  truck_id        String?  @db.Uuid
  trucks          trucks?  @relation(fields: [truck_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones           zones?   @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model trucks {
  id                                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plate_no                                 String?
  length_cm                                Int?
  width_cm                                 Int?
  height_cm                                Int?
  tone                                     Int?
  created_at                               DateTime      @default(now())
  off_day                                  String?       @db.VarChar(255)
  driver_id                                String?       @db.Uuid
  assistant_id                             String?       @db.Uuid
  lorry_trips                              lorry_trips[]
  time_slots                               time_slots[]
  truck_zones                              truck_zones[]
  employees_trucks_assistant_idToemployees employees?    @relation("trucks_assistant_idToemployees", fields: [assistant_id], references: [id], onUpdate: NoAction, map: "fk_assistant")
  employees_trucks_driver_idToemployees    employees?    @relation("trucks_driver_idToemployees", fields: [driver_id], references: [id], onUpdate: NoAction, map: "fk_driver")
  teams                                    teams[]       @relation("teams_truckTotrucks")
}

model installation_schedules {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id               String    @unique @db.Uuid
  installation_team_id   String?   @db.Uuid
  estimated_arrival_time DateTime? @db.Timestamp(6)
  status                 String?   @default("Scheduled")
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  orders                 orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_install_order")
  team                   teams?    @relation(fields: [installation_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_install_team")
}

model scheduler_config {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  warehouse_address String?
  warehouse_postal  String?
  warehouse_latitude  Decimal? @db.Decimal(10, 7)
  warehouse_longitude Decimal? @db.Decimal(10, 7)
  // Mirror of the derived run time (planning_cutoff + planning_run_offset_minutes).
  cron_expression   String?   @default("0 18 * * *")
  enabled           Boolean?  @default(true)
  last_run_at       DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  // B.1 settings. Defaults and ranges: services/schedulerSettingsSpec.js.
  singleton                   Boolean   @unique @default(true)
  grace_minutes               Int       @default(15)
  buffer_minutes              Int       @default(10)
  load_minutes                Int       @default(20)
  unload_minutes              Int       @default(10)
  max_dos_per_slot            Int       @default(25)
  planning_cutoff             String    @default("17:00") @db.VarChar(5)
  planning_run_offset_minutes Int       @default(60)
  base_delivery_minutes       Int       @default(15)
  fallback_install_minutes    Int       @default(0)
  nearby_km                   Int       @default(10)
  updated_by                  String?   @db.Uuid
}

// Dated unavailability (public holidays, events, leave, MC, maintenance).
// resource_type: fleet (every truck and team), truck_type (every truck whose
// tonnage key is scope_value: "1", "3", "unknown"), truck, team or employee
// (resource_id; an employee row is one staff member's leave or MC).
// Fleet and truck_type rows are matched when checked, so trucks and teams added
// later are covered. Polymorphic, so no foreign key; the route checks ids exist.
// Rows saved in one submission share group_id. Rules: services/fleetAvailabilitySpec.js.
model resource_blockoffs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource_type String   @db.VarChar(12)
  resource_id   String?  @db.Uuid
  scope_value   String?  @db.VarChar(20)
  // Any of morning, afternoon, evening (odooAppointmentSessions.js); all three = full day.
  sessions      String[] @default(["morning", "afternoon", "evening"])
  group_id      String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  start_date    DateTime @db.Date
  end_date      DateTime @db.Date
  reason        String   @db.VarChar(20)
  note          String?  @db.VarChar(300)
  created_by    String?  @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([resource_type, resource_id, start_date])
  @@index([start_date, end_date])
  @@index([group_id])
}

model complaint {
  complaint_id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String    @db.Uuid
  employee_id                String?   @db.Uuid
  employee_name              String?   @db.VarChar(100)
  order_id                   String?   @db.Uuid
  product_name               String?   @db.VarChar(100)
  delivery_date              String?   @db.VarChar(20)
  reason                     String?   @db.VarChar(100)
  status                     String?   @default("pending") @db.VarChar(50)
  content                    String?
  date_reported              DateTime? @default(now()) @db.Timestamp(6)
  is_submitted               Boolean?  @default(false)
  media_product_installation String[]
  media_serial_number        String[]
  customers                  customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complaint_customer")
  orders                     orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complaint_order")
}

model rating {
  rating_id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String    @db.Uuid
  order_id                   String    @db.Uuid
  product_name               String    @db.VarChar(100)
  driver_id                  String?   @db.VarChar(50)
  driver_name                String?   @db.VarChar(100)
  delivery_date              String?   @db.VarChar(20)
  delivery_rating            Int?
  service_rating             Int?
  comment                    String?
  created_at                 DateTime? @default(now()) @db.Timestamp(6)
  customer_signature         String?
  media_product_installation String[]
  media_serial_number        String[]
  customers                  customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_customer")
  orders                     orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_order")
}

model system_settings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setting_key   String    @unique @db.VarChar(100)
  setting_value String
  description   String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model installers {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String    @unique @db.Uuid
  company_name     String?   @db.VarChar(255)
  product_category String?   @db.VarChar(255)
  collection_point String?   @db.VarChar(255)
  employees        employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee")
}

model outlets {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_code String      @unique @db.VarChar(255)
  name        String?     @db.VarChar(255)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  employees   employees[]
}

model employee_locations {
  employee_id String    @id
  latitude    Float
  longitude   Float
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  message    String
  type       String?   @default("info") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  is_read    Boolean   @default(false)
  order_id   String?   @db.Uuid
}

model delivery_failure_events {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id           String               @db.Uuid
  failure_reason     String               @db.VarChar(255)
  failure_desc       String?
  evidence_urls      String[]
  confirmed_by       String?              @db.Uuid
  odoo_sync_status   String?              @default("pending") @db.VarChar(20)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  orders             orders               @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model integration_outbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type      String    @db.VarChar(60)
  target          String    @db.VarChar(30)
  payload         Json
  idempotency_key String    @unique @db.VarChar(200)
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  next_retry_at   DateTime? @db.Timestamp(6)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  processed_at    DateTime? @db.Timestamp(6)
}

// Immutable incoming request + decision history. Keep it even if the DO is deleted.
model odoo_sync_runs {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_key       String   @unique
  source        String
  target_date   String?
  status        String   @default("queued")
  attempts      Int      @default(0)
  next_retry_at DateTime? @db.Timestamp(6)
  lease_until   DateTime? @db.Timestamp(6)
  report        Json
  created_at    DateTime @default(now()) @db.Timestamp(6)
  updated_at    DateTime @default(now()) @db.Timestamp(6)

  @@index([status, next_retry_at])
  @@index([created_at])
}

model odoo_change_requests {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String    @db.Uuid
  do_ref              String
  request_kind        String    @db.VarChar(20)
  request_key         String    @unique @db.VarChar(64)
  payload             Json
  before_snapshot     Json
  baseline_hash       String    @db.VarChar(64)
  changes             Json
  status              String    @default("pending") @db.VarChar(20)
  reviewed_by         String?   @db.Uuid
  reviewed_by_name    String?
  review_note         String?
  reviewed_at         DateTime? @db.Timestamp(6)
  applied_snapshot    Json?
  created_at          DateTime  @default(now()) @db.Timestamp(6)

  @@index([status, created_at])
  @@index([order_id])
}

// ── Employee performance & incentives (FR-10) ────────────────────────────────

// Versioned rules: a change inserts a new row, so past awards keep their rule.
model incentive_rules {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  points_per_item        Float                @default(1)
  bonus_points_per_order Float                @default(0)
  rm_per_point           Float                @default(1)
  effective_from         DateTime             @default(now())
  active                 Boolean              @default(true)
  created_by             String?              @db.Uuid
  created_at             DateTime             @default(now())
  awards                 order_point_awards[]

  @@index([active, effective_from])
}

// Snapshot written once when an order completes: one row per crew member.
model order_point_awards {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id       String           @db.Uuid
  employee_id    String           @db.Uuid
  role           String           @db.VarChar(20)
  item_points    Float            @default(0)
  bonus_points   Float            @default(0)
  // [{ order_product_id, product_name, quantity, delivered_quantity, points_per_item, points }]
  item_breakdown Json             @default("[]")
  rule_id        String?          @db.Uuid
  awarded_at     DateTime         @default(now())
  orders         orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee       employees        @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rule           incentive_rules? @relation(fields: [rule_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([order_id, employee_id])
  @@index([employee_id, awarded_at])
}

// Manual extra points for a whole order. Append-only; correct by reversing.
model order_point_adjustments {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id     String   @db.Uuid
  points       Float
  reason       String
  created_by   String?  @db.Uuid
  reverses_id  String?  @unique @db.Uuid
  created_at   DateTime @default(now())
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id])
}

// Points per item, keyed by item name. Odoo order lines carry only a product
// name (no products row), so this is what actually prices an order line.
// item_key is the lower-cased, whitespace-collapsed name.
model item_point_rates {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_key        String   @unique @db.VarChar(255)
  item_name       String   @db.VarChar(255)
  points_per_item Float
  // Unclassified (item_type_id null) = needs admin review: the scheduler uses
  // the fallback install time and a new item earns 0 points until classified.
  item_type_id           String?     @db.Uuid
  // Keyword match waiting for an admin to accept it. Never used for timing.
  suggested_item_type_id String?     @db.Uuid
  // This product's own times. null = follow the item type (then the fallback).
  install_minutes        Int?
  dismantle_minutes      Int?
  // How item_type_id was set: admin | suggestion | odoo (reserved for the GCA push).
  classification_source  String?     @db.VarChar(20)
  updated_by             String?     @db.Uuid
  updated_at             DateTime    @default(now()) @updatedAt
  item_type              item_types? @relation("item_type_assigned", fields: [item_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  suggested_item_type    item_types? @relation("item_type_suggested", fields: [suggested_item_type_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

// Item types (Information > Item > Manage item types). Service time for the
// scheduler: base delivery (scheduler_config) + install + dismantle per unit.
// Each size is its own type. Rules: services/itemTypeSpec.js.
model item_types {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String             @unique @db.VarChar(80)
  // null = not confirmed yet; scheduler_config.fallback_install_minutes is used.
  install_minutes    Int?
  // Only counted on order lines with dismantle_required.
  dismantle_minutes  Int?
  requires_installer Boolean            @default(false)
  // Copied into a product's points when it is given this type and has none yet.
  default_points     Float              @default(0)
  // Each keyword is a set of words that must all appear in the product name.
  keywords           String[]           @default([])
  // Inactive: hidden from the picker and suggestions; assigned products keep it.
  active             Boolean            @default(true)
  updated_by         String?            @db.Uuid
  created_at         DateTime           @default(now())
  updated_at         DateTime           @default(now()) @updatedAt
  items              item_point_rates[] @relation("item_type_assigned")
  suggested_items    item_point_rates[] @relation("item_type_suggested")
}

// B.1 planning run (fixed assignment at the cutoff): one row per run.
// services/planningService.js; plan ~/.claude/plans/b1-planning-run.md.
model planning_runs {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_date   String                   @db.VarChar(10)
  trigger     String                   @db.VarChar(10) // cron | manual
  dry_run     Boolean                  @default(false)
  status      String                   @db.VarChar(10) // running | completed | failed
  summary     Json?
  error       String?
  created_by  String?                  @db.Uuid
  started_at  DateTime                 @default(now()) @db.Timestamp(6)
  finished_at DateTime?                @db.Timestamp(6)
  deferrals   planning_run_deferrals[]

  @@index([plan_date, started_at])
}

// A booked DO the run could not place, why, and a suggested alternative.
model planning_run_deferrals {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id            String        @db.Uuid
  order_id          String        @db.Uuid
  session           String        @db.VarChar(10)
  reason_code       String        @db.VarChar(30)
  reason_detail     String?       @db.VarChar(300)
  suggested_date    String?       @db.VarChar(10)
  suggested_session String?       @db.VarChar(10)
  created_at        DateTime      @default(now()) @db.Timestamp(6)
  run               planning_runs @relation(fields: [run_id], references: [id], onDelete: Cascade)

  @@index([run_id])
  @@index([order_id])
}
