generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  permissions String[]    @default([])
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt
  employees   employees[]
}

model employees {
  id                                    String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                  String?
  display_name                          String?
  email                                 String?                     @unique
  contact_number                        String?
  role_id                               String?                     @db.Uuid
  active_flag                           Boolean                     @default(true)
  password                              String?
  bio                                   String?
  created_at                            DateTime                    @default(now())
  updated_at                            DateTime                    @updatedAt
  outlet_id                             String?                     @db.Uuid
  expo_push_token                       String?
  teamAssignments                       employee_team_assignments[]
  role                                  roles?                      @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  outlets                               outlets?                    @relation(fields: [outlet_id], references: [id], onUpdate: NoAction, map: "fk_employees_outlet")
  installers                            installers?
  orders                                orders[]
  reports                               reports[]                   @relation("EmployeeReports")
  trucks_trucks_assistant_idToemployees trucks[]                    @relation("trucks_assistant_idToemployees")
  trucks_trucks_driver_idToemployees    trucks[]                    @relation("trucks_driver_idToemployees")
}

model teams {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  team_type              String?
  created_at             DateTime                    @default(now())
  available_flag         Boolean                     @default(true)
  assignments            employee_team_assignments[]
  installation_schedules installation_schedules[]
  delivery_timeslots     time_slots[]                @relation("DeliveryTeamSlots")
  warehouse_timeslots    time_slots[]                @relation("WarehouseTeamSlots")
}

model employee_team_assignments {
  id          Int       @id @default(autoincrement())
  employee_id String    @db.Uuid
  team_id     String?   @db.Uuid
  assigned_at DateTime?
  employee    employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  team        teams?    @relation(fields: [team_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([employee_id, team_id])
}

model zones {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_name   String?
  created_at  DateTime      @default(now())
  buildings   buildings[]
  truck_zones truck_zones[]
}

model buildings {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  building_name             String?
  housing_type              String?
  special_equipment_needed  String?
  vehicle_size_limit        String?
  vehicle_length_limit      String?
  vehicle_width_limit       String?
  postal_code               String?
  loading_bay_available     Boolean?
  access_time_window_start  String?
  access_time_window_end    String?
  pre_registration_required Boolean?
  zone_id                   String?   @db.Uuid
  lift_available            Boolean?
  lift_dimensions           String?
  notes                     String?
  parking_distance          String?
  narrow_doorways           Boolean?
  updated_at                DateTime?
  created_at                DateTime  @default(now())
  address                   String?
  latitude                  Decimal?  @db.Decimal(10, 8)
  longitude                 Decimal?  @db.Decimal(11, 8)
  zone                      zones?    @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orders                    orders[]
}

model access_logs {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  changed_at DateTime?
  changes    Json?
}

model chats {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_number    String?
  members         Json?
  names           Json?
  created_at      DateTime?
  last_message_at DateTime?
}

model customers {
  id                            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name                     String?
  email                         String?
  phone                         String?
  address                       String?
  city                          String?
  postcode                      String?
  state                         String?
  created_at                    DateTime?
  notifications_enabled         Boolean?
  passwordhash                  String?
  preferred_delivery_time_start String?     @db.VarChar(10)
  preferred_delivery_time_end   String?     @db.VarChar(10)
  preferred_delivery_notes      String?
  expo_push_token               String?
  complaint                     complaint[]
  orders                        orders[]
  rating                        rating[]
}

model lorry_trips {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  delivery_team_id  String?
  warehouse_team_id String?
  truck_id          String?     @db.Uuid
  created_at        DateTime    @default(now())
  updated_at        DateTime?
  ended_at          DateTime?   @db.Timestamp(6)
  ended_by          String?     @db.Uuid
  started_at        DateTime?   @db.Timestamp(6)
  started_by        String?     @db.Uuid
  status            String?     @default("planned") @db.VarChar(20)
  time_slot_id      String?     @unique @db.Uuid
  time_slot         time_slots? @relation(fields: [time_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_lorry_trip_time_slot")
  trucks            trucks?     @relation(fields: [truck_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model order_products {
  id                           Int       @id @default(autoincrement())
  order_id                     String    @db.Uuid
  product_id                   String?   @db.Uuid
  quantity                     Int?
  dismantle_required           Boolean?
  dismantle_time_min           Int?
  dismantle_time_max           Int?
  service_type                 String?   @db.VarChar(50)
  custom_installation_time_min Int?
  custom_installation_time_max Int?
  item_delivery_status         String?   @default("pending") @db.VarChar(20)
  loaded_at                    DateTime?
  loaded_by                    String?   @db.Uuid
  picked_at                    DateTime?
  picked_by                    String?   @db.Uuid
  picking_status               String?   @default("pending") @db.VarChar(20)
  loaded_serial                String?
  picked_serial                String?
  assigned_serial              String?
  unloaded_at                  DateTime?
  unloaded_by                  String?   @db.Uuid
  unloaded_serial              String?
  odoo_line_id                 Int?
  odoo_product_name            String?   @db.VarChar(255)
  orders                       orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products                     products? @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model orders {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String?                   @db.Uuid
  building_id                String?                   @db.Uuid
  employee_id                String?                   @db.Uuid
  order_status               String?
  number_of_attempts         Int?
  customer_rating            Float?
  proof_of_delivery_url      String?
  customer_feedback          String?
  time_slot_id               String?                   @db.Uuid
  scheduled_start_date_time  DateTime?
  scheduled_end_date_time    DateTime?
  actual_start_date_time     DateTime?
  actual_end_date_time       DateTime?
  actual_arrival_date_time   DateTime?
  created_at                 DateTime?
  updated_at                 DateTime?
  truck_loading_sequence     Int?
  notified_pending           Boolean?                  @default(false)
  notified_scheduled         Boolean?                  @default(false)
  special_equipment_needed   String?
  delivery_notes             String?
  delivery_evidence          String[]
  issue_priority_level       String?                   @db.VarChar(50)
  issue_reason               String?                   @db.VarChar(255)
  issue_desc                 String?
  issue_evidence             String[]
  delivery_start_date_time   DateTime?                 @db.Timestamp(6)
  delivery_end_date_time     DateTime?                 @db.Timestamp(6)
  install_start_date_time    DateTime?                 @db.Timestamp(6)
  install_end_date_time      DateTime?                 @db.Timestamp(6)
  delivery_address           String?
  delivery_city              String?
  delivery_postcode          String?
  delivery_state             String?
  issue_status               String?
  is_complaint_submitted     Boolean?                  @default(false)
  odoo_order_ref             String?                   @unique @db.VarChar(100)
  assignment_status          String?                   @default("unassigned") @db.VarChar(30)
  delivery_remarks           String?
  original_delivery_address  String?
  remarks_contact_name       String?
  remarks_contact_phone      String?
  remarks_delivery_address   String?
  remarks_driver_notes       String?
  dispatched_by              String?                   @db.Uuid
  delivered_by               String?                   @db.Uuid
  notified_d1_at             DateTime?                 @db.Timestamp(6)
  notified_on_the_way_at     DateTime?                 @db.Timestamp(6)
  salesperson_name           String?                   @db.VarChar(255)
  salesperson_phone          String?                   @db.VarChar(50)
  is_escalation_acknowledged Boolean?                  @default(false)
  rescheduled_from_order_id  String?                   @db.Uuid
  resolved_at                DateTime?                 @db.Timestamp(6)
  resolved_by                String?                   @db.Uuid
  issue_reported_at          DateTime?                 @db.Timestamp(6)
  odoo_sales_ref             String?                   @db.VarChar(100)
  complaint                  complaint[]
  delivery_failure_events    delivery_failure_events[]
  installation_schedules     installation_schedules?
  order_products             order_products[]
  buildings                  buildings?                @relation(fields: [building_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers                  customers?                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                  employees?                @relation(fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rescheduled_from           orders?                   @relation("OrderReschedule", fields: [rescheduled_from_order_id], references: [id], onUpdate: NoAction)
  rescheduled_to             orders[]                  @relation("OrderReschedule")
  time_slots                 time_slots?               @relation(fields: [time_slot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating                     rating[]
}

model products {
  id                              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_name                    String?
  package_length_cm               Int?
  package_height_cm               Int?
  package_width_cm                Int?
  fragile_flag                    Boolean?
  installer_team_required_flag    Boolean?
  dismantle_time                  Int?
  created_at                      DateTime         @default(now())
  estimated_installation_time_min Int?
  estimated_installation_time_max Int?
  no_lie_down_flag                Boolean?
  dismantle_required_flag         Boolean?
  available_flag                  Boolean          @default(true)
  order_products                  order_products[]
}

model reports {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content     String?
  status      String?
  created_at  DateTime?
  employee_id String?    @db.Uuid
  employee    employees? @relation("EmployeeReports", fields: [employee_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model time_slots {
  id                      String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                    String?
  time_window_start       String?
  time_window_end         String?
  available_flag          Boolean?
  created_at              DateTime?
  delivery_team_id        String?      @db.Uuid
  warehouse_team_id       String?      @db.Uuid
  truck_id                String?      @db.Uuid
  loading_start_date_time DateTime?    @db.Timestamp(6)
  loading_end_date_time   DateTime?    @db.Timestamp(6)
  departed_at             DateTime?    @db.Timestamp(6)
  ended_at                DateTime?    @db.Timestamp(6)
  ended_by                String?      @db.Uuid
  slot_status             String?      @default("scheduled") @db.VarChar(30)
  started_by              String?      @db.Uuid
  ended_by                String?      @db.Uuid
  // Route Optimisation (B.2) output — computed once per scheduler run, consumed
  // by the driver Route tab so it never has to re-call Google Maps itself.
  route_polyline          String?
  route_distance_m        Int?
  route_duration_s        Int?
  route_computed_at       DateTime?    @db.Timestamp(6)
  orders                  orders[]
  lorry_trip              lorry_trips?
  orders                  orders[]
  delivery_team           teams?       @relation("DeliveryTeamSlots", fields: [delivery_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_slots_delivery_team")
  truck                   trucks?      @relation(fields: [truck_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_slots_truck")
  warehouse_team          teams?       @relation("WarehouseTeamSlots", fields: [warehouse_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_time_slots_warehouse_team")
}

model truck_zones {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zone_id         String?  @db.Uuid
  is_primary_zone Boolean?
  truck_id        String?  @db.Uuid
  trucks          trucks?  @relation(fields: [truck_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  zones           zones?   @relation(fields: [zone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model trucks {
  id                                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plate_no                                 String?
  length_cm                                Int?
  width_cm                                 Int?
  height_cm                                Int?
  tone                                     Int?
  created_at                               DateTime      @default(now())
  off_day                                  String?       @db.VarChar(255)
  driver_id                                String?       @db.Uuid
  assistant_id                             String?       @db.Uuid
  lorry_trips                              lorry_trips[]
  time_slots                               time_slots[]
  truck_zones                              truck_zones[]
  employees_trucks_assistant_idToemployees employees?    @relation("trucks_assistant_idToemployees", fields: [assistant_id], references: [id], onUpdate: NoAction, map: "fk_assistant")
  employees_trucks_driver_idToemployees    employees?    @relation("trucks_driver_idToemployees", fields: [driver_id], references: [id], onUpdate: NoAction, map: "fk_driver")
}

model installation_schedules {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id               String    @unique @db.Uuid
  installation_team_id   String?   @db.Uuid
  estimated_arrival_time DateTime? @db.Timestamp(6)
  status                 String?   @default("Scheduled")
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  orders                 orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_install_order")
  team                   teams?    @relation(fields: [installation_team_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_install_team")
}

model scheduler_config {
  id                String    @id @default(dbgenerated("gen_random_uuid()"))
  warehouse_address String?
  warehouse_postal  String?
  cron_expression   String?   @default("0 0 * * *")
  enabled           Boolean?  @default(true)
  last_run_at       DateTime? @db.Timestamp(6)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @updatedAt @db.Timestamp(6)
}

model complaint {
  complaint_id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String    @db.Uuid
  employee_id                String?   @db.Uuid
  employee_name              String?   @db.VarChar(100)
  order_id                   String?   @db.Uuid
  product_name               String?   @db.VarChar(100)
  delivery_date              String?   @db.VarChar(20)
  reason                     String?   @db.VarChar(100)
  status                     String?   @default("pending") @db.VarChar(50)
  content                    String?
  date_reported              DateTime? @default(now()) @db.Timestamp(6)
  is_submitted               Boolean?  @default(false)
  media_product_installation String[]
  media_serial_number        String[]
  customers                  customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complaint_customer")
  orders                     orders?   @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_complaint_order")
}

model rating {
  rating_id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id                String    @db.Uuid
  order_id                   String    @db.Uuid
  product_name               String    @db.VarChar(100)
  driver_id                  String?   @db.VarChar(50)
  driver_name                String?   @db.VarChar(100)
  delivery_date              String?   @db.VarChar(20)
  delivery_rating            Int?
  service_rating             Int?
  comment                    String?
  created_at                 DateTime? @default(now()) @db.Timestamp(6)
  customer_signature         String?
  media_product_installation String[]
  media_serial_number        String[]
  customers                  customers @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_customer")
  orders                     orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rating_order")
}

model system_settings {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  setting_key   String    @unique @db.VarChar(100)
  setting_value String
  description   String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
}

model installers {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id      String    @unique @db.Uuid
  company_name     String?   @db.VarChar(255)
  product_category String?   @db.VarChar(255)
  collection_point String?   @db.VarChar(255)
  employees        employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee")
}

model outlets {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  outlet_code String      @unique @db.VarChar(255)
  name        String?     @db.VarChar(255)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime    @default(now()) @db.Timestamptz(6)
  employees   employees[]
}

model employee_locations {
  employee_id String    @id
  latitude    Float
  longitude   Float
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  message    String
  type       String?   @default("info") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  is_read    Boolean   @default(false)
  order_id   String?   @db.Uuid
}

model delivery_failure_events {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id         String   @db.Uuid
  failure_reason   String   @db.VarChar(255)
  failure_desc     String?
  evidence_urls    String[]
  confirmed_by     String?  @db.Uuid
  odoo_sync_status String?  @default("pending") @db.VarChar(20)
  created_at       DateTime @default(now()) @db.Timestamp(6)
  orders           orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model integration_outbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type      String    @db.VarChar(60)
  target          String    @db.VarChar(30)
  payload         Json
  idempotency_key String    @unique @db.VarChar(200)
  status          String    @default("pending") @db.VarChar(20)
  attempts        Int       @default(0)
  next_retry_at   DateTime? @db.Timestamp(6)
  last_error      String?
  created_at      DateTime  @default(now()) @db.Timestamp(6)
  processed_at    DateTime? @db.Timestamp(6)
}
